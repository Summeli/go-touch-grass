{
  "manifest_version": 3,
  "name": "go-touch-grass",
  "version": "0.1.0",
  "description": "Hides racist, sexist and violent forum posts using TypeSafe's Jev model.",
  "action": {
    "default_title": "Moderate posts on this page"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.typesafe.ai/*"]
}
